# Copy to .env.local for local runs and add the same names in Vercel >
# Project > Settings > Environment Variables for the live site.
# NAMES ONLY here: never commit real values, never paste them in chat or email.

# Website: the live address (https://www.showcasemedia.pro once the domain is on).
NEXT_PUBLIC_SITE_URL=
# The part after /f/ in Pierre's Formspree form URL (not a secret).
NEXT_PUBLIC_FORMSPREE_ID=
# "true" while testing: the form shows what it would send and sends nothing.
# Set to "false" once the Formspree test submission arrives.
NEXT_PUBLIC_BOOKING_TEST_MODE=

# Booking form → the studio (server only). The studio's address
# (https://portal.showcasemedia.pro). STUDIO_INTAKE_SECRET is a secret:
# Vercel only, the same value as the studio's BOOKING_INTAKE_SECRET.
STUDIO_URL=
STUDIO_INTAKE_SECRET=

# Client galleries live in the studio. The "Client Login" links go here
# (default https://portal.showcasemedia.pro in src/config/site.ts).
NEXT_PUBLIC_PORTAL_URL=
